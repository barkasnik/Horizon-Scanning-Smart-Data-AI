<script>
(() => {
  const state={mode:'weekly',payload:null,articles:[]};
  const $=id=>document.getElementById(id);
  const esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  const safeUrl=u=>/^https?:\/\//i.test(String(u||''))?u:'#';
  const arr=v=>Array.isArray(v)?v:[];
  const pretty=k=>String(k||'').replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
  const fmtDate=d=>{if(!d)return'Date unknown';const x=new Date(d);return Number.isNaN(x.getTime())?esc(d):x.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});};
  const tagClass=t=>{const s=t.toLowerCase();return s.includes('policygap')?'policygap':s.includes('threat')?'threat':s.includes('opportunity')?'opportunity':s.includes('monitor')?'monitor':''};
  const framework=(title,obj)=>{const entries=Object.entries(obj||{}).filter(([,v])=>arr(v).length);if(!entries.length)return'';return `<details><summary>${esc(title)}</summary><div class="framework">${entries.map(([k,v])=>`<div class="framework-box"><h4>${esc(pretty(k))}</h4><ul>${arr(v).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`).join('')}</div></details>`};

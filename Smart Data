name: Smart Data AI Radar

on:
  workflow_dispatch:
    inputs:
      mode:
        description: Intelligence mode
        required: true
        default: weekly
        type: choice
        options:
          - weekly
          - monthly
  schedule:
    # Weekly briefing: Monday 07:10 UTC
    - cron: "10 7 * * 1"
    # Monthly briefing: first day of each month 07:30 UTC
    - cron: "30 7 1 * *"

permissions:
  contents: write

concurrency:
  group: smart-data-ai-radar-${{ github.ref }}
  cancel-in-progress: false

jobs:
  radar:
    runs-on: ubuntu-latest
    timeout-minutes: 55
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Select weekly or monthly mode
        id: cadence
        shell: bash
        env:
          MANUAL_MODE: ${{ inputs.mode }}
          SCHEDULE: ${{ github.event.schedule }}
        run: |
          if [ -n "$MANUAL_MODE" ]; then
            MODE="$MANUAL_MODE"
          elif [ "$SCHEDULE" = "30 7 1 * *" ]; then
            MODE="monthly"
          else
            MODE="weekly"
          fi
          echo "mode=$MODE" >> "$GITHUB_OUTPUT"
          echo "Selected mode: $MODE"

      - name: Install radar and test dependencies
        run: pip install -e '.[dev]'

      - name: Run automated tests
        run: pytest -q

      - name: Install Ollama
        run: curl -fsSL https://ollama.com/install.sh | sh

      - name: Cache Ollama model
        uses: actions/cache@v4
        with:
          path: ~/.ollama/models
          key: ollama-qwen2.5-1.5b-instruct-v1

      - name: Start Ollama and ensure free local model is available
        shell: bash
        env:
          OLLAMA_MODEL: ${{ vars.OLLAMA_MODEL || 'qwen2.5:1.5b-instruct' }}
        run: |
          ollama serve > /tmp/ollama.log 2>&1 &
          for i in {1..20}; do
            if curl -fsS http://127.0.0.1:11434/api/tags >/dev/null; then
              break
            fi
            sleep 2
          done
          ollama pull "$OLLAMA_MODEL"

      - name: Run horizon scanner
        env:
          SEARCH_BACKEND: google_news
          LLM_BACKEND: ollama
          OLLAMA_MODEL: ${{ vars.OLLAMA_MODEL || 'qwen2.5:1.5b-instruct' }}
        run: smart-data-radar run --mode "${{ steps.cadence.outputs.mode }}" --out-dir output

      - name: Commit public-safe briefing
        shell: bash
        run: |
          MODE="${{ steps.cadence.outputs.mode }}"
          git config user.name "smart-data-ai-radar[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -f "output/${MODE}-latest.md" "output/${MODE}-latest.json" "output/${MODE}-latest.html"
          git diff --cached --quiet || git commit -m "chore: update ${MODE} Smart Data AI radar"
          git push


